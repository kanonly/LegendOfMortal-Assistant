  <LuaScript><![CDATA[
-- LegendOfMortal / Unity Mono x64 / Cheat Engine 7.5
-- Self-contained: no external Lua file, game DLL patch, or BepInEx change.
if LOMCT and LOMCT.disable then LOMCT.disable() end
LOMCT = {version = '2.0', rows = {}, groups = {}, uiEntries = {}, enabled = false}
local T = LOMCT
local title = '启用／重新定位（先进入存档；取消勾选即关闭）'
local specs = {
  {3, '銀兩', '资源'},
  {19, '行動次數', '资源'},
  {31, '武學點數', '资源'},
  {20, '個人貢獻度', '资源'},
  {0, '體力', '基础属性'},
  {1, '內力', '基础属性'},
  {2, '輕功', '基础属性'},
  {4, '魅力', '基础属性'},
  {5, '學問', '基础属性'},
  {6, '心理衛生', '基础属性'},
  {12, '嘴力', '基础属性'},
  {29, '防禦', '基础属性'},
  {17, '鍛造', '技能与抗性'},
  {18, '毒藥', '技能与抗性'},
  {21, '廚藝', '技能与抗性'},
  {22, '抗毒', '技能与抗性'},
  {23, '抗麻', '技能与抗性'},
  {7, '命運', '其他属性（含剧情数值）'},
  {8, '性情', '其他属性（含剧情数值）'},
  {9, '處世', '其他属性（含剧情数值）'},
  {10, '修養', '其他属性（含剧情数值）'},
  {11, '道德', '其他属性（含剧情数值）'},
  {13, '門派規模', '其他属性（含剧情数值）'},
  {14, '門派名聲', '其他属性（含剧情数值）'},
  {15, '門派人數', '其他属性（含剧情数值）'},
  {16, '向心力', '其他属性（含剧情数值）'},
  {24, '稱號', '其他属性（含剧情数值）'},
  {25, '愛人', '其他属性（含剧情数值）'},
  {26, '額外行動次數_1', '其他属性（含剧情数值）'},
  {27, '娘化', '其他属性（含剧情数值）'},
  {28, '陰陽內功', '其他属性（含剧情数值）'},
  {30, '變心', '其他属性（含剧情数值）'},
  {32, '全武學點數', '其他属性（含剧情数值）'},
  {33, '門派資產', '其他属性（含剧情数值）'},
  {34, '門派貢獻', '其他属性（含剧情数值）'},
  {36, '全鍛造點數', '其他属性（含剧情数值）'},
  {37, '全毒藥點數', '其他属性（含剧情数值）'},
  {38, '全貢獻度', '其他属性（含剧情数值）'},
  {39, '額外行動次數_2', '其他属性（含剧情数值）'},
  {40, '額外行動次數_3', '其他属性（含剧情数值）'},
  {100, '武功刀劍', '其他属性（含剧情数值）'},
  {101, '武功暗器', '其他属性（含剧情数值）'},
  {102, '武功拳掌', '其他属性（含剧情数值）'},
  {103, '武功腿法', '其他属性（含剧情数值）'},
  {104, '武功奇門', '其他属性（含剧情数值）'},
  {105, '武功軟兵器', '其他属性（含剧情数值）'},
  {106, '武功槍棍', '其他属性（含剧情数值）'},
  {107, '武功內功', '其他属性（含剧情数值）'},
  {201, '儒學', '其他属性（含剧情数值）'},
  {202, '道學', '其他属性（含剧情数值）'},
  {203, '佛學', '其他属性（含剧情数值）'},
  {301, '戰役預設血量', '其他属性（含剧情数值）'},
  {401, '攻擊爆擊', '其他属性（含剧情数值）'},
  {402, '暗器爆擊', '其他属性（含剧情数值）'},
}

local function need(value, message)
  if value == nil or value == 0 then error(message, 0) end
  return value
end

local function int32(value)
  if value and value >= 0x80000000 then return value - 0x100000000 end
  return value
end

-- Zero is valid for stat values, unlike object pointers.
local function integer(address)
  local value = readInteger(address)
  if value == nil then error('无法读取属性整数，请关闭后重新启用。', 0) end
  return int32(value)
end

local function fields(class)
  local result = {}
  for _, f in ipairs(mono_class_enumFields(class, true)) do result[f.name] = f end
  return result
end

local function offset(map, name)
  if not map[name] then error('当前游戏缺少字段：' .. name, 0) end
  return map[name].offset
end

local function pointer(address, label)
  return need(readPointer(address), label .. ' 尚未初始化，请先进入存档。')
end

local function managedString(address)
  if not address or address == 0 then return '' end
  local length = readInteger(address + 0x10)
  if not length or length > 1024 then error('场景名称无法读取。', 0) end
  if length == 0 then return '' end
  return need(readString(address + 0x14, length * 2, true), '场景名称无法读取。')
end

local function group(description, parent)
  local record = getAddressList().createMemoryRecord()
  record.IsGroupHeader = true
  record.Description = description
  record.DontSave = true
  record.appendToEntry(parent)
  return record
end

-- Stable semantic IDs shared by the CT and the optional desktop front end.
function T.expose(record, metadata)
  metadata.record = record
  T.uiEntries[#T.uiEntries + 1] = metadata
end

local function connectMono(reconnect)
  if not LaunchMonoDataCollector then
    error('Mono 数据收集器启动失败，请确认 CE 的 autorun/monoscript.lua 完整。', 0)
  end
  if reconnect and monopipe then
    -- Drop an out-of-sync response stream; do not retry on the same pipe.
    local old = monopipe
    monopipe = nil
    mono_AttachedProcess, monoBase = 0, 0
    old.destroy()
  end
  need(LaunchMonoDataCollector(false), 'Mono 数据收集器启动失败，请确认 CE 的 Mono 收集器文件完整。')
end

function T.disable()
  local extensionOK, extensionError = true, nil
  if T.disableExtensions then extensionOK, extensionError = pcall(T.disableExtensions) end
  T.enabled = false
  for _, row in ipairs(T.rows) do row.record.Active = false end
  for _, record in ipairs(T.groups) do record.destroy() end
  T.rows, T.groups = {}, {}
  T.uiEntries = {}
  T.context = nil
  if T.root then T.root.Description = title end
  if not extensionOK then error(extensionError, 0) end
end

local function locate()
  local pid = need(getProcessIDFromProcessName('Mortal.exe'), '没有找到 Mortal.exe，请先启动游戏。')
  if getOpenedProcessID() ~= pid then openProcess(pid) end
  if getOpenedProcessID() ~= pid then error('无法附加 Mortal.exe。', 0) end
  if not targetIs64Bit() then error('本表适用于 64 位 Mortal.exe。', 0) end
  connectMono(true)
  local managerClass = need(mono_findClass('Mortal.Core', 'PlayerStatManagerData'), '找不到 PlayerStatManagerData。')
  local statClass = need(mono_findClass('Mortal.Core', 'GameStat'), '找不到 GameStat。')
  local mf, sf = fields(managerClass), fields(statClass)
  if not mf._instance then error('找不到主角单例字段 _instance。', 0) end
  local staticBase = need(mono_class_getStaticFieldAddress(0, managerClass), '找不到主角单例静态区。')
  local instanceSlot = staticBase + mf._instance.offset
  local manager = pointer(instanceSlot, '主角数据')
  local sceneOffset = offset(mf, '_currentScene')
  local sceneClass = need(mono_findClass('Mortal.Core', 'SceneController'), '找不到场景管理器。')
  local sceneFields = fields(sceneClass)
  local sceneInstanceField = sceneFields['<Instance>k__BackingField']
  if not sceneInstanceField then error('找不到场景管理器单例。', 0) end
  local sceneBase = need(mono_class_getStaticFieldAddress(0, sceneClass), '场景管理器未初始化。')
  local sceneManager = pointer(sceneBase + sceneInstanceField.offset, '场景管理器')
  local titleScene = managedString(readPointer(sceneManager + offset(sceneFields, '_title')))
  local currentScene = managedString(readPointer(manager + sceneOffset))
  if currentScene == '' or titleScene == '' or currentScene == titleScene then
    error('当前仍在标题画面，请先进入存档，加载完成后再启用。', 0)
  end
  local statsOffset = offset(mf, '_stats')
  local stats = pointer(manager + statsOffset, '主角属性集合')
  local statsClass = need(mono_object_getClass(stats), '无法解析主角属性集合。')
  local listOffset = offset(fields(statsClass), '_list')
  local list = pointer(stats + listOffset, '主角属性列表')
  local lf = fields(need(mono_object_getClass(list), '无法解析属性 List。'))
  local itemsOffset, sizeOffset = offset(lf, '_items'), offset(lf, '_size')
  local items = pointer(list + itemsOffset, '主角属性数组')
  local count = integer(list + sizeOffset)
  -- MonoArray x64 ABI: object + bounds + max_length; references begin at 0x20.
  local capacity = readQword(items + 0x18)
  if count < 1 or count > 1024 or not capacity or count > capacity then
    error('主角属性列表无效，请在存档加载完成后重新启用。', 0)
  end
  local typeOffset = offset(sf, '_type')
  local byType, indexes = {}, {}
  for i = 0, count - 1 do
    local object = readPointer(items + 0x20 + i * 8)
    if object and object ~= 0 then
      local kind = integer(object + typeOffset)
      if byType[kind] then error('属性编号重复，停止定位：' .. kind, 0) end
      byType[kind] = object
      indexes[kind] = i
    end
  end
  local selected = {}
  for _, spec in ipairs(specs) do
    local object = byType[spec[1]]
    if object then
      if mono_object_getClass(object) ~= statClass then error('属性对象类型不符：' .. spec[2], 0) end
      selected[#selected + 1] = {spec = spec, object = object, index = indexes[spec[1]]}
    end
  end
  need(byType[3], '当前集合中没有银两属性，请进入存档。')
  local method = need(mono_findMethod('Mortal.Core', 'GameStat', 'get_FinalValue'), '找不到最终值读取方法。')
  return {
    pid = pid, instanceSlot = instanceSlot, manager = manager,
    sceneOffset = sceneOffset, titleScene = titleScene,
    stats = stats, list = list, items = items, count = count,
    statsOffset = statsOffset, listOffset = listOffset,
    itemsOffset = itemsOffset, sizeOffset = sizeOffset,
    valueOffset = offset(sf, '_value'), minOffset = offset(sf, '_min'),
    maxOffset = offset(sf, '_max'), limitOffset = offset(sf, '_limitAddition'),
    typeOffset = typeOffset, finalMethod = method, selected = selected
  }
end

local function checkContext(c)
  if getOpenedProcessID() ~= c.pid or getProcessIDFromProcessName('Mortal.exe') ~= c.pid then
    error('游戏进程已关闭或切换。', 0)
  end
  if readPointer(c.instanceSlot) ~= c.manager
    or readPointer(c.manager + c.statsOffset) ~= c.stats
    or readPointer(c.stats + c.listOffset) ~= c.list
    or readPointer(c.list + c.itemsOffset) ~= c.items
    or readInteger(c.list + c.sizeOffset) ~= c.count then
    error('主角数据已改变，请重新定位。', 0)
  end
  local scene = managedString(readPointer(c.manager + c.sceneOffset))
  if scene == '' or scene == c.titleScene then error('已返回标题画面，请进入存档后重新启用。', 0) end
end

function T.refresh()
  -- CE may pump GUI messages while waiting for a Mono RPC. Avoid re-entry.
  if T.refreshing then return end
  T.refreshing = true
  local ok, err = pcall(function()
    local c = T.context
    checkContext(c)
    local function collect()
      local values = {}
      for i, row in ipairs(T.rows) do
        if integer(row.object + c.typeOffset) ~= row.kind then error('属性对象已改变，请重新定位。', 0) end
        local lo, hi = integer(row.object + c.minOffset), integer(row.object + c.maxOffset)
        local limit = integer(row.object + c.limitOffset)
        local final = mono_invoke_method(0, c.finalMethod, row.object, {})
        if final == nil then error('读取' .. row.name .. '最终值失败，请关闭后重新启用。', 0) end
        final = int32(final)
        if type(final) ~= 'number' or final < lo or final > hi + limit then
          error(row.name .. '最终值响应不符合游戏范围。', 0)
        end
        values[i] = {lo, hi, final, hi + limit}
      end
      return values
    end
    local readOK, values = pcall(collect)
    if not readOK then
      checkContext(c)
      connectMono(true)
      c.finalMethod = need(mono_findMethod('Mortal.Core', 'GameStat', 'get_FinalValue'), '重连后找不到最终值方法。')
      values = collect() -- One retry on a new connection; errors propagate.
    end
    for i, row in ipairs(T.rows) do
      local v = values[i]
      row.minimum, row.maximum, row.final = v[1], v[2], v[3]
      row.info.Description = string.format('只读（刷新时）：基础范围 %d ～ %d；最终值 %d；最终上限 %d', v[1], v[2], v[3], v[4])
    end
  end)
  T.refreshing = false
  if not ok then error(tostring(err), 0) end
end

function T.enable(root)
  T.disable()
  T.root = root
  local ok, err = pcall(function()
    local c = locate()
    T.context = c
    local parents = {}
    for _, entry in ipairs(c.selected) do
      local spec, object = entry.spec, entry.object
      if not parents[spec[3]] then
        parents[spec[3]] = group(spec[3], root)
        T.groups[#T.groups + 1] = parents[spec[3]]
      end
      local record = getAddressList().createMemoryRecord()
      record.DontSave = true
      record.Description = spec[2] .. '（基础值）'
      record.Type = vtDword
      record.ShowAsSigned = true
      record.Address = string.format('%X', c.instanceSlot)
      record.OffsetCount = 5
      record.Offset[0] = c.valueOffset
      record.Offset[1] = 0x20 + entry.index * 8
      record.Offset[2] = c.itemsOffset
      record.Offset[3] = c.listOffset
      record.Offset[4] = c.statsOffset
      record.appendToEntry(parents[spec[3]])
      local row = {record = record, info = group('只读：正在读取…', record), object = object, kind = spec[1], name = spec[2]}
      T.rows[#T.rows + 1] = row
      T.expose(record, {id = 'stat:' .. spec[1], name = spec[2], section = 'stats', category = spec[3], kind = 'stat', stat = row})
      record.OnActivate = function(_, before)
        if before then
          local valid = pcall(checkContext, c)
          return T.enabled and valid
        end
        return true
      end
      record.OnValueChangedByUser = function(r)
        -- Respect the game's base range, without changing _min/_max.
        local lo, hi = integer(object + c.minOffset), integer(object + c.maxOffset)
        local value = integer(object + c.valueOffset)
        local clamped = math.max(lo, math.min(hi, value))
        if clamped ~= value then r.Value = tostring(clamped) end
      end
    end
    T.refresh()
    T.enabled = true
    if T.extend then T.extend(root, c) end
    root.Description = '已启用：' .. #T.rows .. ' 项属性及旧表扩展（取消勾选可关闭）'
    root.Collapsed = false
  end)
  if not ok then T.disable(); error(tostring(err), 0) end
end

-- Dynamic records contain runtime addresses and must never be saved in the CT.
local root = getAddressList().getMemoryRecordByID(0)
if root then
  -- Native Lua callbacks manage the table lifecycle without an assembly patch.
  root.OnActivate = function(record, before)
    if before then
      local ok, err = pcall(T.enable, record)
      if not ok then
        record.Description = '启用失败：' .. tostring(err)
        return false
      end
    end
    return true
  end
  root.OnDeactivate = function(_, before)
    if before then T.disable() end
    return true
  end
  root.OnDestroy = function() T.disable(); T.root = nil end
end
local refreshEntry = getAddressList().getMemoryRecordByID(2)
if refreshEntry then
  refreshEntry.OnActivate = function(_, before)
    if before then
      if not T.enabled then
        refreshEntry.Description = '刷新失败：请先勾选第一行启用本表。'
      else
        local ok, err = pcall(T.refresh)
        if not ok then
          if root.Active then root.Active = false else T.disable() end
        end
        refreshEntry.Description = ok and '刷新只读最终值（改值或更换装备后点击）' or ('刷新失败：' .. tostring(err))
      end
      return false
    end
    return true
  end
end

-- Migration layer. The old CT is only a feature reference, never executable input.
local E = {records = {}, configRecords = {}, fieldCache = {}, bridge = nil, toggles = {}, parameters = {}}
T.legacy = E
local relationNames = {
  [0] = '小師妹',
  [1] = '大師兄',
  [2] = '二師兄',
  [3] = '三師兄',
  [4] = '四師兄',
  [5] = '掌門人',
  [6] = '瑞杏',
  [7] = '葉雲舟',
  [8] = '葉雲裳',
  [9] = '樊嘯天',
  [10] = '萬里鵬程',
  [11] = '劉顎',
  [12] = '龍湘',
  [13] = '龍淵',
  [14] = '石公遠',
  [102] = '南宮深',
  [103] = '南宮淺',
  [205] = '尹志平',
  [206] = '福韞',
  [215] = '孟珙',
  [605] = '虞小梅',
  [606] = '夏侯蘭',
  [607] = '郁竹',
  [608] = '魏菊',
  [609] = '上官螢',
  [401] = '王二壯',
  [403] = '趙逵',
  [404] = '丹霞子',
  [405] = '申屠龍',
  [409] = '車軒轅',
  [501] = '主角',
  [502] = '虞小梅_探險隊長',
  [800] = '宋悲',
  [805] = '鶴手',
  [808] = '解無塵',
  [809] = '李富貴',
  [825] = '夏靈犀',
  [831] = '孟仙謠',
  [999] = '瑞笙',
  [990] = '葉雲啾_1',
  [991] = '葉雲啾_2',
}
local runtimeName = 'LOMCT.Runtime.3a68c29d583c'
local runtimeHex = ''

local function mapFor(object)
  local class = need(mono_object_getClass(object), '无法解析扩展数据对象。')
  if not E.fieldCache[class] then E.fieldCache[class] = fields(class) end
  return E.fieldCache[class]
end
local function top(description, parent)
  local r = group(description, parent)
  T.groups[#T.groups + 1] = r
  return r
end
local function valueRecord(parent, description, base, forward, vartype)
  local r = getAddressList().createMemoryRecord()
  r.DontSave = true
  r.Description = description
  r.Type = vartype or vtDword
  r.ShowAsSigned = true
  r.Address = string.format('%X', base)
  r.OffsetCount = #forward
  for i, v in ipairs(forward) do r.Offset[#forward - i] = v end
  r.appendToEntry(parent)
  E.records[#E.records + 1] = r
  return r
end
local function childChain(prefix, a, b)
  local t = {}
  for _, v in ipairs(prefix) do t[#t + 1] = v end
  t[#t + 1] = a
  if b then t[#t + 1] = b end
  return t
end
local function enumRecord(r, text)
  r.DropDownList.Text = text
  r.DropDownReadOnly = true
  r.DropDownDescriptionOnly = true
  r.DisplayAsDropDownListItem = true
end
local function listData(collection)
  local listOff = offset(mapFor(collection), '_list')
  local list = pointer(collection + listOff, '扩展列表')
  local lf = mapFor(list)
  local itemsOff = offset(lf, '_items')
  local items = pointer(list + itemsOff, '扩展数组')
  local count = integer(list + offset(lf, '_size'))
  local capacity = readQword(items + 0x18)
  if count < 0 or count > 10000 or not capacity or count > capacity then error('扩展列表长度无效。', 0) end
  return {list = list, items = items, count = count, prefix = {listOff, itemsOff}}
end
local function collectionRecords(parent, baseSlot, owner, collectionField, kind)
  local collectionOff = offset(mapFor(owner), collectionField)
  local collection = pointer(owner + collectionOff, collectionField)
  local list = listData(collection)
  local prefix = {collectionOff, list.prefix[1], list.prefix[2]}
  local first = list.count > 0 and readPointer(list.items + 0x20) or 0
  if first == 0 then group('当前列表为空', parent); return end
  local f = mapFor(first)
  local countOff = offset(f, kind == 'relationship' and '_value' or '_currentCount')
  for i = 0, list.count - 1 do
    local object = readPointer(list.items + 0x20 + i * 8)
    if object and object ~= 0 then
      local label, id
      if kind == 'relationship' then
        id = integer(object + offset(f, '_type'))
        label = relationNames[id] or ('人物编号 ' .. id)
      else
        id = managedString(readPointer(object + offset(f, '_id')))
        local note = f._devNote and managedString(readPointer(object + f._devNote.offset)) or ''
        label = (note ~= '' and note or id) .. ' [' .. id .. ']'
      end
      local r = valueRecord(parent, label, baseSlot, childChain(prefix, 0x20 + i * 8, countOff))
      local stable = kind == 'relationship' and ('relation:' .. id) or ('item:' .. kind .. ':' .. id)
      local section = kind == 'relationship' and 'relations' or 'items'
      T.expose(r, {id = stable, name = label, section = section, category = kind, kind = kind,
        minimum = 0, maximum = kind == 'relationship' and integer(object + offset(f, '_max')) or 2147483647})
      if kind == 'relationship' then
        local active = valueRecord(r, '已结识／显示', baseSlot, childChain(prefix, 0x20 + i * 8, offset(f, '_active')), vtByte)
        T.expose(active, {id = stable .. ':active', parentId = stable, name = '已结识／显示', section = section, category = kind, kind = 'boolean', minimum = 0, maximum = 1})
        enumRecord(active, '0:否\n1:是')
        group('好感上限：' .. integer(object + offset(f, '_max')), r)
      elseif kind == 'book' then
        local level = valueRecord(r, '当前修炼等级（直改不追补升级奖励）', baseSlot, childChain(prefix, 0x20 + i * 8, offset(f, '_currentMartialLevel')))
        local points = valueRecord(r, '当前修炼点数', baseSlot, childChain(prefix, 0x20 + i * 8, offset(f, '_currentLevelPoint')))
        T.expose(level, {id = stable .. ':level', parentId = stable, name = '当前修炼等级', section = section, category = kind, kind = 'level', minimum = 0, maximum = 2147483647, note = '直接改等级不追补升级奖励。'})
        T.expose(points, {id = stable .. ':points', parentId = stable, name = '当前修炼点数', section = section, category = kind, kind = 'points', minimum = 0, maximum = 2147483647})
      end
      r.Collapsed = true
    end
  end
  parent.Collapsed = true
end

local function invokeBridge(name)
  local b = need(E.bridge, '脚本增强尚未加载。')
  if getOpenedProcessID() ~= b.pid or getProcessIDFromProcessName('Mortal.exe') ~= b.pid then
    error('游戏进程已改变，请重新启用本表。', 0)
  end
  local method = b.methods[name]
  if not method then
    method = need(mono_class_findMethod(b.class, name), '缺少运行时方法：' .. name)
    b.methods[name] = method
  end
  return mono_invoke_method(0, method, 0, {})
end
local function loadBridge()
  connectMono(true)
  if T.prepareEnhancements then T.prepareEnhancements() end
  local bytes = {}
  for pair in runtimeHex:gmatch('%x%x') do bytes[#bytes + 1] = tonumber(pair, 16) end
  local path = getTempFolder() .. runtimeName .. '.dll'
  -- A loaded managed assembly may keep its file open on Windows. Its name is
  -- content-versioned by the builder, so reuse it instead of overwriting it.
  if not fileExists(path) then
    local stream = createMemoryStream()
    stream.write(bytes)
    stream.saveToFile(path)
    stream.destroy()
  end
  local assembly = need(mono_loadAssemblyFromFile(path), '无法加载内嵌运行时。')
  local image = need(mono_getImageFromAssembly(assembly), '无法读取运行时程序集。')
  local class = need(mono_image_findClass(image, 'LOMCT.Runtime', 'Control'), '无法找到运行时入口。')
  E.bridge = {pid = getOpenedProcessID(), class = class, methods = {}}
  local address = need(invokeBridge('Attach'), '运行时补丁安装失败。')
  if readInteger(address) ~= 0x4C4F4D32 or readInteger(address + 4) ~= 1 then
    error('运行时配置块校验失败。', 0)
  end
  E.config = address
  E.capabilities = readInteger(address + 12)
  return address
end
local function has(bit)
  return math.floor(E.capabilities / 2 ^ bit) % 2 == 1
end
local function configValue(parent, description, off, valueType)
  local r = valueRecord(parent, description, E.config + off, {}, valueType)
  table.remove(E.records) -- Config records are destroyed when their group closes.
  E.configRecords[#E.configRecords + 1] = r
  E.parameters[off] = r
  return r
end
local function toggle(parent, description, off, capability)
  local r = group(description, parent)
  E.toggles[off] = r
  E.configRecords[#E.configRecords + 1] = r
  if not has(capability) then
    r.Description = '[当前版本入口不可用] ' .. description
    r.OnActivate = function() return false end
    return r
  end
  r.OnActivate = function(_, before)
    if before then
      if not T.enabled or not E.config or getOpenedProcessID() ~= E.bridge.pid then return false end
      return writeInteger(E.config + off, 1)
    end
    return true
  end
  r.OnDeactivate = function(_, before)
    if before and E.config and getOpenedProcessID() == E.bridge.pid then writeInteger(E.config + off, 0) end
    return true
  end
  return r
end
local function stopScripts()
  for _, r in ipairs(E.configRecords) do r.Active = false end
  E.configRecords = {}
  E.toggles, E.parameters = {}, {}
  if E.bridge and getOpenedProcessID() == E.bridge.pid and getProcessIDFromProcessName('Mortal.exe') == E.bridge.pid then
    -- Deactivate the shared block first, even if a Mono RPC has failed.
    if E.config then writeInteger(E.config + 4, 0) end
    local ok, result = pcall(invokeBridge, 'Detach')
    if not ok or result ~= 1 then
      connectMono(true)
      result = invokeBridge('Detach')
      if result ~= 1 then error('增强开关已关闭，但撤销补丁失败；请重启游戏。', 0) end
    end
  end
  E.config = nil
  if E.scripts then
    while E.scripts.Count > 0 do E.scripts.Child[0].destroy() end
  end
end

local function startScripts(parent)
  stopScripts()
  local ok, err = pcall(function()
    loadBridge()
    local budgets = group('升级／开发', parent)
    toggle(budgets, '炼丹最大消费不减反增（升级额度）', 16, 2)
    toggle(budgets, '修炼最大消费不减反增（修炼额度）', 20, 3)
    toggle(budgets, '炼丹开发无门派规模要求', 24, 4)
    toggle(budgets, '锻造开发无门派规模要求', 28, 4)
    local statGroup = group('属性不减反增（逐项开启，仍受原上限约束）', parent)
    for _, spec in ipairs(specs) do
      local r = toggle(statGroup, spec[2] .. '不减反增', 1024 + spec[1] * 4, 0)
      configValue(r, '变化倍率（1～1000）', 4096 + spec[1] * 4)
      r.Collapsed = true
    end
    local relation = toggle(parent, '好感度增长加倍', 32, 1)
    configValue(relation, '倍率（1～1000，默认10）', 36)
    enumRecord(configValue(relation, '好感下降转为增长', 40), '0:否\n1:是')
    local battle = group('战役设置（只识别主角／敌方／我方）', parent)
    toggle(battle, '我方人数不减', 68, 7)
    toggle(battle, '主角生命不减反增', 48, 5)
    toggle(battle, '主角内力不减反增', 52, 6)
    toggle(battle, '敌人内力快速清零（发生内力变化时）', 56, 6)
    local damage = toggle(battle, '对敌伤害加倍', 60, 5)
    configValue(damage, '伤害倍数（默认10）', 64)
    local combat = group('决斗设置', parent)
    toggle(combat, '主角生命不减反增', 80, 8)
    toggle(combat, '主角内力不减反增', 84, 9)
    toggle(combat, '敌人内力快速清零（发生内力变化时）', 88, 9)
    local combatDamage = toggle(combat, '对敌伤害加倍', 92, 8)
    configValue(combatDamage, '伤害倍数（默认10）', 96)
    local dice = toggle(parent, '设置天命轮盘点数', 112, 10)
    configValue(dice, '骰子点数（0～100，默认50）', 116)
    local status = group('补丁安装报告（入口检测，不代表已实战验证）', parent)
    local text = invokeBridge('Report')
    for line in tostring(text):gmatch('[^\r\n]+') do group(line, status) end
    parent.Collapsed = false
  end)
  if not ok then stopScripts(); error(err, 0) end
end

function T.disableExtensions()
  stopScripts()
  for _, r in ipairs(E.records) do
    -- Config descendants may already have been destroyed by stopScripts.
    if r and not r.IsGroupHeader then pcall(function() r.Active = false end) end
  end
  E.records, E.fieldCache, E.bridge = {}, {}, nil
  E.scripts = nil
end
function T.extend(root, context)
  E.records, E.fieldCache = {}, {}
  connectMono(true)
  local managerFields = mapFor(context.manager)
  local timeParent = top('游戏时间（修改可能改变剧情触发）', root)
  local timeDataOff = offset(managerFields, '_gameTimeData')
  local timeData = pointer(context.manager + timeDataOff, '游戏时间')
  local timeOff = offset(mapFor(timeData), 'GameTime')
  local time = pointer(timeData + timeOff, '当前日期')
  local tf = mapFor(time)
  for _, spec in ipairs({{'Year', '第几年'}, {'Month', '月份'}, {'Stage', '阶段'}, {'DayEnvironment', '环境'}}) do
    local r = valueRecord(timeParent, spec[2], context.instanceSlot, {timeDataOff, timeOff, offset(tf, spec[1])})
    local maximum = ({Year = 2147483647, Month = 12, Stage = 3, DayEnvironment = 2})[spec[1]]
    T.expose(r, {id = 'time:' .. spec[1], name = spec[2], section = 'time', category = 'time', kind = 'time', minimum = 1, maximum = maximum, note = '修改时间可能影响剧情触发。'})
    if spec[1] == 'Stage' then enumRecord(r, '1:上旬\n2:中旬\n3:下旬') end
    if spec[1] == 'DayEnvironment' then enumRecord(r, '1:白天\n2:晚上') end
  end
  local relationParent = top('人际关系', root)
  collectionRecords(relationParent, context.instanceSlot, context.manager, '_relationships', 'relationship')
  local inventory = top('物品数量（含未持有物品）', root)
  local dbClass = need(mono_findClass('Mortal.Core', 'ItemDatabase'), '找不到 ItemDatabase。')
  local dbf = fields(dbClass)
  local dbSlot = need(mono_class_getStaticFieldAddress(0, dbClass), '物品数据库未初始化。') + offset(dbf, '_instance')
  local db = pointer(dbSlot, '物品数据库')
  for _, spec in ipairs({{'_books', '书籍', 'book'}, {'_miscs', '杂项', 'misc'}, {'_special', '宝物', 'special'}, {'_consumables', '消耗品', 'consumable'}}) do
    collectionRecords(group(spec[2], inventory), dbSlot, db, spec[1], spec[3])
  end
  inventory.Collapsed = true
  E.scripts = top('启用脚本增强（默认关闭；其下功能需逐项勾选）', root)
  E.scripts.Options = '[moHideChildren]'
  E.scripts.OnActivate = function(record, before)
    if before then
      local ok, err = pcall(startScripts, record)
      if not ok then record.Description = '增强启用失败：' .. tostring(err); return false end
    end
    return true
  end
  E.scripts.OnDeactivate = function(_, before)
    if before then stopScripts() end
    return true
  end
end
]]></LuaScript>
</CheatTable>